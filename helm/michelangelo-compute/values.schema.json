{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rayManager",
    "runtime",
    "tests",
    "kuberay-operator",
    "spark-operator"
  ],
  "properties": {
    "rayManager": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name", "tokenSecret", "grants"],
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "tokenSecret": {
          "type": "boolean"
        },
        "grants": {
          "type": "object",
          "additionalProperties": false,
          "required": ["spark", "kueueRead"],
          "properties": {
            "spark": {
              "type": "boolean"
            },
            "kueueRead": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["config", "objectStorageCredentials"],
      "properties": {
        "config": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean"]
          }
        },
        "objectStorageCredentials": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "create", "accessKeyId", "secretAccessKey"],
          "properties": {
            "name": {
              "type": "string"
            },
            "create": {
              "type": "boolean"
            },
            "accessKeyId": {
              "type": "string"
            },
            "secretAccessKey": {
              "type": "string"
            }
          }
        }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image"],
      "properties": {
        "image": {
          "type": "string"
        }
      }
    },
    "kuberay-operator": {
      "$ref": "#/definitions/subchart"
    },
    "spark-operator": {
      "$ref": "#/definitions/subchart"
    }
  },
  "definitions": {
    "subchart": {
      "type": "object",
      "additionalProperties": true,
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    }
  }
}
