###############################################################################
# $ cd $REPO_ROOT/python
# $ docker build -t <IMAGE_NAME> -f ./examples/Dockerfile.optimized .
###############################################################################

# =============================================================================
# Stage 1: Spark Downloader (with fallback logic)
# =============================================================================
FROM alpine:latest as spark-downloader
ARG SPARK_VERSION=4.2.0
ARG HADOOP_VERSION=3

# Install curl for downloading
RUN apk add --no-cache curl

# Smart download with fallback: check local cache first, then download
RUN echo "Checking for cached Spark ${SPARK_VERSION}..." && \
    if [ -f /tmp/spark-${SPARK_VERSION}-bin-hadoop${HADOOP_VERSION}.tgz ]; then \
        echo "Using cached Spark from /tmp/"; \
        cp /tmp/spark-${SPARK_VERSION}-bin-hadoop${HADOOP_VERSION}.tgz /spark.tgz; \
    else \
        echo "No cached Spark found, downloading from Apache..."; \
        echo "Downloading Spark ${SPARK_VERSION} with Hadoop ${HADOOP_VERSION} (~400MB)..."; \
        curl -L --retry 3 --retry-delay 5 --fail --progress-bar \
            https://archive.apache.org/dist/spark/spark-${SPARK_VERSION}/spark-${SPARK_VERSION}-bin-hadoop${HADOOP_VERSION}.tgz \
            -o /spark.tgz || \
        { echo "Primary mirror failed, trying dlcdn.apache.org..."; \
          curl -L --retry 3 --retry-delay 5 --fail --progress-bar \
            https://dlcdn.apache.org/spark/spark-${SPARK_VERSION}/spark-${SPARK_VERSION}-bin-hadoop${HADOOP_VERSION}.tgz \
            -o /spark.tgz; }; \
        echo "Spark download completed successfully"; \
    fi

# Verify the download
RUN ls -lh /spark.tgz && \
    echo "Spark archive size: $(du -h /spark.tgz | cut -f1)"

# =============================================================================
# Stage 2: Main Application Image
# =============================================================================
# Use a base image with Python installed
FROM nvidia/cuda:12.8.0-base-ubuntu22.04

# Capture Git SHA build argument
ARG GIT_SHA=GIT_SHA
LABEL git.commit=${GIT_SHA}
LABEL git.sha=${GIT_SHA}
LABEL org.opencontainers.image.revision=${GIT_SHA}
ENV GIT_SHA=${GIT_SHA}

# Install dependencies required for building Python
RUN apt-get update && apt-get install -y \
    curl \
    software-properties-common \
    vim \
    wget \
    build-essential \
    libssl-dev \
    libreadline-dev \
    libbz2-dev \
    libsqlite3-dev \
    libffi-dev \
    liblzma-dev \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# Set Python version
# Spark/PySpark 4.2 requires Python >= 3.10; 3.11 matches the integration-test runner.
ENV PYTHON_VERSION=3.11.17

# Download and install Python from source
RUN wget https://www.python.org/ftp/python/$PYTHON_VERSION/Python-$PYTHON_VERSION.tgz && \
    tar xvf Python-$PYTHON_VERSION.tgz && \
    cd Python-$PYTHON_VERSION && \
    ./configure --enable-optimizations && \
    make -j$(nproc) && \
    make altinstall && \
    cd .. && \
    rm -rf Python-$PYTHON_VERSION*

# Ensure python3.11 is the default
RUN ln -sf /usr/local/bin/python3.11 /usr/bin/python3 && \
    ln -sf /usr/local/bin/python3.11 /usr/bin/python

# Install pip and Poetry
RUN python --version
RUN curl -sSL https://install.python-poetry.org | python3 -
ENV PATH="/root/.local/bin:$PATH"
RUN poetry --version

# --------------------------
# 3. Install Spark (optimized with multi-stage)
# --------------------------
# Must match the pyspark pin in pyproject.toml (python >= 3.10 branch).
ENV SPARK_VERSION=4.2.0
ENV HADOOP_VERSION=3
ENV SPARK_HOME=/opt/spark

# Copy the pre-downloaded Spark from the downloader stage
COPY --from=spark-downloader /spark.tgz /tmp/spark.tgz

# Extract Spark and set up symlink (much faster now!)
RUN echo "Extracting pre-downloaded Spark..." && \
    tar -xz -C /opt -f /tmp/spark.tgz && \
    ln -s /opt/spark-${SPARK_VERSION}-bin-hadoop${HADOOP_VERSION} ${SPARK_HOME} && \
    rm /tmp/spark.tgz && \
    echo "Spark installation completed in $(ls -ld ${SPARK_HOME} | awk '{print $9}')"

ENV PATH="${SPARK_HOME}/bin:${SPARK_HOME}/sbin:${PATH}"

# -----------------------------
# 4. Add Hadoop AWS & AWS SDK
# -----------------------------
# Create JAR directory if needed
RUN mkdir -p ${SPARK_HOME}/jars

# Download hadoop-aws and the AWS SDK JARs for S3 support. Versions must match the
# Hadoop client bundled with SPARK_VERSION (Spark 4.2.0 ships hadoop-client-*-3.5.0);
# taken from hadoop-project 3.5.0's POM (aws-java-sdk-v2.version,
# amazon-s3-analyticsaccelerator-s3.version). Hadoop 3.4+ uses AWS SDK v2.
RUN curl -L -o ${SPARK_HOME}/jars/hadoop-aws-3.5.0.jar https://repo1.maven.org/maven2/org/apache/hadoop/hadoop-aws/3.5.0/hadoop-aws-3.5.0.jar && \
    curl -L -o ${SPARK_HOME}/jars/bundle-2.35.4.jar https://repo1.maven.org/maven2/software/amazon/awssdk/bundle/2.35.4/bundle-2.35.4.jar && \
    curl -L -o ${SPARK_HOME}/jars/analyticsaccelerator-s3-1.3.1.jar https://repo1.maven.org/maven2/software/amazon/s3/analyticsaccelerator/analyticsaccelerator-s3/1.3.1/analyticsaccelerator-s3-1.3.1.jar

RUN mkdir -p ${SPARK_HOME}/conf && \
    echo "spark.hadoop.fs.s3a.impl=org.apache.hadoop.fs.s3a.S3AFileSystem" >> ${SPARK_HOME}/conf/spark-defaults.conf && \
    echo "spark.hadoop.fs.s3a.aws.credentials.provider=software.amazon.awssdk.auth.credentials.DefaultCredentialsProvider" >> ${SPARK_HOME}/conf/spark-defaults.conf

###
### Install Java
###
# Install OpenJDK 17 (multi-arch compatible and open-source; required by Spark 4)
RUN apt-get update && apt-get install -y openjdk-17-jdk

# Detect the actual installed JDK path at build time and pin a stable,
# arch-independent symlink to it, rather than hardcoding an architecture.
RUN ln -sfn "$(dirname "$(dirname "$(readlink -f "$(which java)")")")" /usr/lib/jvm/default-java

ENV JAVA_HOME=/usr/lib/jvm/default-java
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# Set working directory
WORKDIR /app

ENV PYTHONPATH=/app

# Copy the application code
COPY . .

# Copy Kaggle credentials
#RUN mkdir -p /root/.kaggle
#COPY kaggle.json /root/.kaggle/kaggle.json
#RUN chmod 600 /root/.kaggle/kaggle.json

# Install python dependencies
RUN ls -alF ./

RUN poetry config virtualenvs.create false
RUN poetry install -E example

# Activate Poetry's virtual environment by default
ENV PATH="/app/.venv/bin:$PATH"

COPY examples/entrypoint.sh /opt/entrypoint.sh
RUN chmod +x /opt/entrypoint.sh

ENTRYPOINT ["/opt/entrypoint.sh"]